datasource db {
    provider = "postgresql"
    url      = "postgres://admin:admin@10.4.48.13:5432/nest"
    // url      = env("DB_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum RoleType {
    INNER_ADMIN
    CUSTOMER
}

enum UserType {
    USER
    ADMIN
}

enum UserStatus {
    ACTIVE
    LOCKED
}

model Role {
    name       String
    permission Json
    type       RoleType @default(CUSTOMER)
    id         String   @id @default(uuid())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

model User {
    name               String
    phone              String?
    phoneVerify        Boolean?
    email              String?
    emailVerify        Boolean?
    passwordBcrypt     String?
    passwordAlgorithm  String?
    passwordUpdateAt   DateTime?
    passwordWrongTimes Int?
    passwordUnlockAt   DateTime?
    type               UserType[]
    status             UserStatus @default(ACTIVE)
    role               String[]
    avatarUrl          String?
    avatarUpdateAt     DateTime?
    lastLogin          DateTime?
    firstLogin         DateTime?
    id                 String     @id @default(uuid())
    createdAt          DateTime   @default(now())
    updatedAt          DateTime   @updatedAt
}

model UserToken {
    userId      String
    hashedToken String   @unique
    id          String   @id @default(uuid())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
