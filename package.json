{
    "name": "nestjs-server",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "upgrade": "./node_modules/.bin/npm-check -u",
        "husky-init": "husky init",
        "commit": "./node_modules/cz-customizable/standalone.js",
        "apidoc": "./node_modules/.bin/apidoc -i ./src -o ./apidoc",
        "struct": "npx @compodoc/compodoc -p tsconfig.json -s",
        "create": "./node_modules/.bin/nest g",
        "product": "pm2 start pm2.json --env production"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HandsomeTea/nestjs-server.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/HandsomeTea/nestjs-server/issues"
    },
    "homepage": "https://github.com/HandsomeTea/nestjs-server#readme",
    "dependencies": {
        "@coco-sheng/js-tools": "^1.0.1",
        "@nestjs/apollo": "^12.1.0",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.2.2",
        "@nestjs/core": "^10.0.0",
        "@nestjs/graphql": "^12.1.1",
        "@nestjs/mapped-types": "*",
        "@nestjs/mongoose": "^10.0.6",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/sequelize": "^10.0.1",
        "@nestjs/terminus": "^10.2.3",
        "@prisma/client": "^5.13.0",
        "@svtslv/nestjs-ioredis": "^1.0.2",
        "agentkeepalive": "^4.5.0",
        "axios": "^1.6.8",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "compression": "^1.7.4",
        "express-http-context": "^1.2.4",
        "graphql": "^16.8.1",
        "graphql-query-complexity": "^0.12.0",
        "graphql-subscriptions": "^2.0.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "log4js": "^6.9.1",
        "pg": "^8.11.5",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "sequelize-typescript": "^2.1.6"
    },
    "devDependencies": {
        "@compodoc/compodoc": "^1.1.24",
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/express": "^4.17.17",
        "@types/ioredis": "^5.0.0",
        "@types/jest": "^29.5.2",
        "@types/node": "^20.3.1",
        "@types/supertest": "^6.0.0",
        "@typescript-eslint/eslint-plugin": "^7.9.0",
        "@typescript-eslint/parser": "^7.9.0",
        "apidoc": "^1.2.0",
        "commitizen": "^4.3.0",
        "cz-customizable": "^7.0.0",
        "eslint": "^8.51.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "husky": "^9.0.11",
        "jest": "^29.5.0",
        "npm-check": "^6.0.1",
        "prettier": "^3.0.0",
        "prisma": "^5.13.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.2",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.4.5"
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-customizable"
        }
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "forceExit": true,
        "detectOpenHandles": true,
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1"
        }
    }
}
